# =============================================================================
# FlowPost Environment Example
# =============================================================================
# Copy this file to .env for local development.
# In Vercel, configure these values in Project Settings -> Environment Variables.

# -----------------------------------------------------------------------------
# App URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
LANGGRAPH_API_URL=http://localhost:54367

# -----------------------------------------------------------------------------
# Database - Supabase Postgres
# -----------------------------------------------------------------------------
# Use Supabase's pooled connection string on Vercel.
# Example:
# DATABASE_URI=postgresql://postgres.project_ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URI=postgresql://flowpost:flowpost_dev_password@localhost:5433/flowpost?sslmode=disable
POSTGRES_POOL_MAX=1

# -----------------------------------------------------------------------------
# Clerk Authentication
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Comma-separated Clerk user IDs with admin access.
ADMIN_USER_IDS=
NEXT_PUBLIC_ADMIN_USER_IDS=

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
IMAGE_MODEL=gemini-2.5-flash-image

OPENAI_API_KEY=
GEMINI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=flowpost

# -----------------------------------------------------------------------------
# Search and content APIs
# -----------------------------------------------------------------------------
SERPER_API_KEY=
PERPLEXITY_API_KEY=
FIRECRAWL_API_KEY=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Social platform integrations
# -----------------------------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=54367
