# ##############################################################################
#                        FLOWPOST ENVIRONMENT CONFIGURATION
# ##############################################################################
#
# Copy this file to .env and fill in your values.
#
# Variables are organized by where they're used:
#
#   🔐 GITHUB SECRET  = Must be set in GitHub Actions Secrets for CI/CD
#   🖥️  LOCAL ONLY     = Only used when running locally
#   📦 BOTH           = Used both locally AND in deployments
#
# ##############################################################################


# ==============================================================================
# 🔐 GITHUB ACTIONS SECRETS (Required for CI/CD Deployments)
# ==============================================================================
# These MUST be configured in: GitHub → Settings → Secrets → Actions
# Use the EXACT secret names shown in comments.
# ==============================================================================

# -----------------------------------------------------------------------------
# Azure Infrastructure (Required for deployments)
# GitHub Secrets: ARM_CLIENT_ID, ARM_CLIENT_SECRET, ARM_SUBSCRIPTION_ID,
#                 ARM_TENANT_ID, AZURE_CREDENTIALS
# Get from: Azure Portal → App registrations → Create service principal
# -----------------------------------------------------------------------------
ARM_CLIENT_ID=your-azure-client-id
ARM_CLIENT_SECRET=your-azure-client-secret
ARM_SUBSCRIPTION_ID=your-azure-subscription-id
ARM_TENANT_ID=your-azure-tenant-id
AZURE_CREDENTIALS={"clientId":"...","clientSecret":"...","subscriptionId":"...","tenantId":"..."}

# -----------------------------------------------------------------------------
# PostgreSQL Admin Password (Required)
# GitHub Secret: POSTGRES_ADMIN_PASSWORD
# Used by: Terraform to create/update PostgreSQL server
# Note: DATABASE_URI is auto-constructed by Terraform - don't add to GitHub!
# -----------------------------------------------------------------------------
POSTGRES_ADMIN_PASSWORD=your-strong-postgres-password

# -----------------------------------------------------------------------------
# Authentication (Required)
# GitHub Secrets: CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY
# Get from: https://dashboard.clerk.com/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# -----------------------------------------------------------------------------
# AI Providers (At least ONE required)
# GitHub Secrets: GEMINI_API_KEY and/or OPENAI_API_KEY
# Get from: https://aistudio.google.com/ or https://platform.openai.com/
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=sk-your-openai-api-key

# -----------------------------------------------------------------------------
# Optional GitHub Secrets (for full functionality)
# -----------------------------------------------------------------------------
# LANGCHAIN_API_KEY=your-langchain-api-key          # For LangSmith tracing
# SERPER_API_KEY=your-serper-api-key                # For web search
# PERPLEXITY_API_KEY=your-perplexity-api-key        # For AI search
# FIRECRAWL_API_KEY=your-firecrawl-api-key          # For web scraping
# STRIPE_SECRET_KEY=sk_test_your-stripe-key         # For payments
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret   # For Stripe webhooks
# ADMIN_USER_IDS=user_xxx,user_yyy                  # Comma-separated Clerk IDs


# ==============================================================================
# 🖥️  LOCAL DEVELOPMENT ONLY
# ==============================================================================
# These are NOT needed in GitHub Secrets.
# ==============================================================================

# -----------------------------------------------------------------------------
# Local Database Connection
# For local dev connecting to Azure PostgreSQL
# NOT needed in GitHub - Terraform auto-constructs DATABASE_URI
# -----------------------------------------------------------------------------
DATABASE_URI=postgresql://pgadmin:your-password@your-server.postgres.database.azure.com:5432/your_db?sslmode=require
POSTGRES_POOL_MAX=5

# For local Docker PostgreSQL (alternative):
# DATABASE_URI=postgresql://flowpost:flowpost_dev_password@localhost:5433/flowpost?sslmode=disable

# -----------------------------------------------------------------------------
# LangGraph API URL (local development server)
# -----------------------------------------------------------------------------
LANGGRAPH_API_URL=http://localhost:54367

# -----------------------------------------------------------------------------
# Clerk Local Configuration
# -----------------------------------------------------------------------------
CLERK_ENCRYPTION_KEY=generate-32-char-random-string
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
AI_PROVIDER=gemini                    # Options: gemini, openai
LLM_MODEL=gemini-2.5-flash           # Or: gpt-4o, gpt-4o-mini
IMAGE_MODEL=gemini-2.5-flash-image   # Or: dall-e-3
USE_GOOGLE_SEARCH_GROUNDING=true     # Enable real-time data in Gemini
# LLM_TEMPERATURE=0.5                # 0.0=deterministic, 1.0=creative

# -----------------------------------------------------------------------------
# LangSmith Tracing (optional, for debugging)
# -----------------------------------------------------------------------------
# LANGSMITH_API_KEY=your-langsmith-key
# LANGSMITH_PROJECT=flowpost
# LANGSMITH_TRACING_V2=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
SKIP_USED_URLS_CHECK=true
# USE_ARCADE_AUTH=true
# ARCADE_API_KEY=your-arcade-api-key

# -----------------------------------------------------------------------------
# GitHub Token (for repo content features)
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=ghp_your_github_token


# ==============================================================================
# 📦 SOCIAL MEDIA OAUTH CREDENTIALS
# ==============================================================================
# Configured via web UI at /dashboard/connections
# These are for reference/backup only
# ==============================================================================

# Instagram/Threads (from Meta for Developers)
# INSTAGRAM_CLIENT_ID=your-instagram-client-id
# INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# Twitter/X OAuth
# TWITTER_CLIENT_ID=your-twitter-client-id
# TWITTER_CLIENT_SECRET=your-twitter-client-secret

# LinkedIn OAuth
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret


# ==============================================================================
# 📋 ENVIRONMENT REFERENCE (Documentation Only)
# ==============================================================================
# These show database details per environment for reference.
# Do NOT add these to GitHub Secrets - Terraform handles this automatically.
#
# To deploy to different environments:
# 1. Update POSTGRES_ADMIN_PASSWORD in GitHub Secrets for that environment
# 2. Terraform will auto-construct the correct DATABASE_URI
# ==============================================================================

# DEV Environment
# - Server: flowpost-dev-postgres.postgres.database.azure.com
# - Database: flowpost_dev_db
# - Deploys from: main/develop branch

# UAT Environment
# - Server: flowpost-uat-postgres.postgres.database.azure.com
# - Database: flowpost_uat_db
# - Deploys from: v* tags (manual approval)

# PROD Environment
# - Server: flowpost-prod-postgres.postgres.database.azure.com
# - Database: flowpost_prod_db
# - Deploys from: workflow_dispatch (manual only)


# ==============================================================================
# 🚀 GITHUB ACTIONS SECRETS CHECKLIST
# ==============================================================================
# Copy this checklist when setting up a new environment:
#
# REQUIRED:
# □ ARM_CLIENT_ID
# □ ARM_CLIENT_SECRET
# □ ARM_SUBSCRIPTION_ID
# □ ARM_TENANT_ID
# □ AZURE_CREDENTIALS (JSON format)
# □ POSTGRES_ADMIN_PASSWORD
# □ CLERK_PUBLISHABLE_KEY
# □ CLERK_SECRET_KEY
# □ GEMINI_API_KEY (or OPENAI_API_KEY)
#
# OPTIONAL:
# □ OPENAI_API_KEY
# □ LANGCHAIN_API_KEY
# □ SERPER_API_KEY
# □ PERPLEXITY_API_KEY
# □ FIRECRAWL_API_KEY
# □ STRIPE_SECRET_KEY
# □ STRIPE_WEBHOOK_SECRET
# □ ADMIN_USER_IDS
# ==============================================================================
